{
  "permissions": {
    "deny": [
      "Bash(railway up*)",
      "Bash(railway redeploy*)",
      "Bash(eas *)",
      "Bash(vercel *)",
      "Bash(git push*)",
      "Bash(psql *DATABASE_URL*)",
      "Bash(*postgres.railway.internal*)",
      "Bash(railway variables --set*)",
      "Bash(railway variable set*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh"
          }
        ]
      }
    ]
  }
}
